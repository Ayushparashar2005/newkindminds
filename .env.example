# KindMinds Environment Configuration
# Copy this file to .env (in the project root) and fill in what you need.
# Everything is optional — the app runs without a .env file.

# Database: local SQLite by default. Set a PostgreSQL URL to use Postgres instead.
# DATABASE_URL=postgresql://user:password@host:5432/kindminds
DATABASE_URL=sqlite:///./kindminds_dev.db

# Groq LLM API key — enables AI SOP summaries and thought reframing.
# Get a free key at https://console.groq.com/keys. Without it, safe built-in fallbacks are used.
GROQ_API_KEY=

# Backend port (frontend expects 8001 by default)
BACKEND_PORT=8001

# Frontend → backend URL (put this in frontend/.env if you change the port)
# PUBLIC_API_URL=http://localhost:8001/api
