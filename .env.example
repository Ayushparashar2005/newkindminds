# KindMinds Environment Configuration
# Neon PostgreSQL Database with PostGIS
DATABASE_URL=postgresql://kindminds_owner:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/kindminds?sslmode=require
# Local fallback if testing without remote Neon
# DATABASE_URL=sqlite:///./kindminds_dev.db

# Groq LLM API Key (used for grounding guidance, SOP summary & translations, no medical diagnosis)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000/api

# Frontend URL
PUBLIC_API_URL=http://localhost:8000/api

# Authentication (Clerk or JWT Secret)
CLERK_SECRET_KEY=sk_test_...
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
JWT_SECRET_KEY=kindminds-humanitarian-platform-secure-jwt-key-2026

# Encryption key for private journal storage (AES-256 32-byte hex)
JOURNAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Map Tiles (OpenStreetMap / Humanitarian tiles)
PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

