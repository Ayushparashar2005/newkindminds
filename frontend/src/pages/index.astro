---
import Layout from '../layouts/Layout.astro';
import { PhoneCall } from 'lucide-react';

const shared = [
  { href: '/disaster/map', label: 'Relief map', note: 'Shelters, hospitals and active incidents' },
  { href: '/disaster/organizations', label: 'Organisations', note: 'NDMA, NDRF, state agencies and NGOs' },
  { href: '/disaster/sop', label: 'Safety procedures', note: 'NDMA and WHO guidance' },
  { href: '/disaster/impact', label: 'Relief coverage', note: 'Which areas still need help' },
];
---

<Layout title="KindMinds: disaster relief and mental health support" showSidebar={false}>
  <div class="max-w-6xl mx-auto py-6 md:py-10">
    <h1 class="signage text-[44px] sm:text-[64px] md:text-[84px] text-charcoal max-w-4xl">
      What do you need right now?
    </h1>
    <p class="mt-5 text-lg text-charcoal-muted max-w-2xl">
      KindMinds connects people hit by floods, cyclones and earthquakes in India with verified shelters, relief teams and mental-health support.
    </p>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
      <a
        href="/needer"
        class="group flex flex-col justify-between min-h-[320px] rounded-xl bg-charcoal text-surface p-6 md:p-8 hover:bg-charcoal-light transition-colors"
      >
        <div>
          <h2 class="signage text-[44px] md:text-[56px] text-surface">I need help</h2>
          <p class="mt-3 text-base text-surface/80 max-w-sm">
            For you or your family: shelter, drinking water, food, medicine, evacuation, or someone to talk to.
          </p>
          <ul class="mt-5 space-y-1 text-sm text-surface/70">
            <li>Ask for help in three short steps</li>
            <li>Find the nearest open shelter or hospital</li>
            <li>Calm down with guided grounding and a private journal</li>
          </ul>
        </div>
        <span class="mt-6 inline-flex self-start items-center h-[38px] rounded-lg bg-surface text-charcoal px-4 text-sm font-medium">
          Get help
        </span>
      </a>

      <a
        href="/helper"
        class="group flex flex-col justify-between min-h-[320px] rounded-xl bg-surface-card text-charcoal border border-stone-200 p-6 md:p-8 hover:border-stone-300 transition-colors"
      >
        <div>
          <h2 class="signage text-[44px] md:text-[56px] text-charcoal">I'm here to help</h2>
          <p class="mt-3 text-base text-charcoal-muted max-w-sm">
            For NGOs, relief agencies, medical teams, NDRF and SDRF units, shelter operators and volunteers.
          </p>
          <ul class="mt-5 space-y-1 text-sm text-charcoal-muted">
            <li>Accept and assign incoming requests</li>
            <li>Track stock at relief camps and depots</li>
            <li>Coordinate search and rescue teams</li>
          </ul>
        </div>
        <span class="mt-6 inline-flex self-start items-center h-[38px] rounded-lg bg-charcoal text-surface px-4 text-sm font-medium">
          Open responder desk
        </span>
      </a>
    </div>

    <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl border border-emergency/40 bg-surface-card px-5 py-4">
      <PhoneCall className="w-5 h-5 text-emergency shrink-0" aria-hidden="true" />
      <p class="text-sm text-charcoal flex-1">
        <strong>In danger right now? Don't wait for this app.</strong> Call 112 for police, fire and ambulance. Disaster helpline 1078. Ambulance 108.
      </p>
      <a href="tel:112" class="inline-flex items-center justify-center h-[38px] rounded-lg bg-emergency text-white px-4 text-sm font-medium hover:bg-emergency-hover">
        Call 112
      </a>
    </div>

    <section class="mt-12" aria-labelledby="shared-heading">
      <h2 id="shared-heading" class="text-[28px]">Open to everyone</h2>
      <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-stone-200">
        {shared.map((s) => (
          <li class="border-b border-stone-200 lg:border-b-0 lg:border-r last:border-r-0">
            <a href={s.href} class="block py-4 pr-4 lg:px-4 lg:first:pl-0 hover:bg-surface-card">
              <span class="block text-base font-semibold text-charcoal">{s.label}</span>
              <span class="block text-sm text-charcoal-muted">{s.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-xs text-charcoal-muted max-w-2xl">
        Agencies, hospitals, helplines and NDRF units listed here are real Indian public services. Numbers and centres change during an emergency, so confirm with the official helpline before you travel.
      </p>
    </section>
  </div>
</Layout>
