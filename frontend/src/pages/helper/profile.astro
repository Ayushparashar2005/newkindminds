---
import Layout from '../../layouts/Layout.astro';
import { DemoBanner } from '../../components/ui/DemoBanner';
import { HelperProfile } from '../../components/helper/HelperProfile';
---

<Layout title="Your profile | KindMinds" panel="helper">
  <div class="space-y-6 max-w-3xl">
    <DemoBanner client:load />

    <div>
      <h1 class="text-[28px] md:text-[32px]">Your profile</h1>
      <p class="text-sm text-charcoal-muted mt-1">
        Your role, organisation and the areas you cover.
      </p>
    </div>

    <HelperProfile client:load />
  </div>
</Layout>
