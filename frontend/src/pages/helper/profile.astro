---
import Layout from '../../layouts/Layout.astro';
import { DemoBanner } from '../../components/ui/DemoBanner';
import { ShieldCheck, UserCheck, Building2, MapPin, Phone } from 'lucide-react';
---

<Layout title="Responder Profile & Capabilities — Helper Panel" panel="helper">
  <div class="space-y-6 max-w-3xl">
    <DemoBanner client:load />

    <div>
      <h1 class="text-2xl font-black text-charcoal tracking-tight">Helper Profile & Credentials</h1>
      <p class="text-sm text-charcoal-muted mt-1">
        Configure your humanitarian role, organization affiliation, and operational coverage zones.
      </p>
    </div>

    <div class="neu-card p-6 md:p-8 space-y-6">
      <div class="flex items-center gap-4 border-b border-stone-200 pb-5">
        <div class="w-14 h-14 rounded-2xl bg-dustyblue text-white flex items-center justify-center font-black text-xl">
          DR
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-black text-charcoal">Dr. Rajesh Varma</h2>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1">
              <ShieldCheck className="w-3 h-3 text-emerald-600" />
              Verified Responder
            </span>
          </div>
          <p class="text-xs text-charcoal-muted mt-0.5">Role: Medical Response Coordinator • Apex Disaster Health Coalition</p>
        </div>
      </div>

      <div class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="font-bold text-charcoal block mb-1">Helper Type / Category:</label>
            <div class="p-2.5 bg-surface-inset rounded neu-inset font-semibold text-charcoal">
              Medical Professional & Field Triage Lead
            </div>
          </div>

          <div>
            <label class="font-bold text-charcoal block mb-1">Affiliated Organization:</label>
            <div class="p-2.5 bg-surface-inset rounded neu-inset font-semibold text-charcoal">
              Apex Disaster Health Coalition (NGO)
            </div>
          </div>
        </div>

        <div>
          <label class="font-bold text-charcoal block mb-1">Operational Coverage Regions:</label>
          <div class="p-2.5 bg-surface-inset rounded neu-inset font-semibold text-charcoal">
            Western Coast (Porbandar, Veraval, Dwarka, Junagadh)
          </div>
        </div>

        <div>
          <label class="font-bold text-charcoal block mb-1">Specialized Assistance Capabilities:</label>
          <div class="flex flex-wrap gap-1.5 mt-1">
            <span class="px-2.5 py-1 bg-stone-200 rounded text-stone-800 font-medium">✓ Trauma First Aid</span>
            <span class="px-2.5 py-1 bg-stone-200 rounded text-stone-800 font-medium">✓ Mobile Clinics</span>
            <span class="px-2.5 py-1 bg-stone-200 rounded text-stone-800 font-medium">✓ Insulin & Cold Chain Care</span>
            <span class="px-2.5 py-1 bg-stone-200 rounded text-stone-800 font-medium">✓ Psychological First Aid</span>
            <span class="px-2.5 py-1 bg-stone-200 rounded text-stone-800 font-medium">✓ Wheelchair Evacuation</span>
          </div>
        </div>

        <div>
          <label class="font-bold text-charcoal block mb-1">Public Verification Desk Contact:</label>
          <div class="p-2.5 bg-surface-inset rounded neu-inset font-semibold text-charcoal">
            +91-98765-43210 (Field Dispatch Operations)
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-stone-200 flex justify-between items-center text-xs">
        <span class="text-charcoal-muted">Credential ID: KM-VERIFIED-MED-2026</span>
        <button
          type="button"
          onclick="alert('Profile details updated and synced with registry.')"
          class="px-4 py-2 bg-dustyblue text-white rounded text-xs font-bold hover:bg-dustyblue-hover transition"
        >
          Save Profile Changes
        </button>
      </div>
    </div>
  </div>
</Layout>

