---
import Layout from '../../layouts/Layout.astro';
import { KindMindsMap } from '../../components/maps/KindMindsMap';
---

<Layout title="Relief map | KindMinds" panel="needer">
  <div class="space-y-4">
    <div>
      <h1 class="text-[28px] md:text-[32px]">Relief map</h1>
      <p class="text-sm text-charcoal-muted mt-1">
        Shelters, hospitals, drinking water and rescue teams near you.
      </p>
    </div>
    <!-- client:only="react" is required for Leaflet: it needs the browser DOM -->
    <KindMindsMap panel="needer" client:only="react" />
  </div>
</Layout>
